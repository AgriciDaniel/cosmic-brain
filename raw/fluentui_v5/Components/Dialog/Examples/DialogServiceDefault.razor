@inject IDialogService DialogService

<FluentStack HorizontalGap="24px"
             Wrap="true">
    
    <FluentSwitch @bind-Value="@IsModal"
                  Label="Is Modal"
                  LabelPosition="LabelPosition.Above" />

    <FluentSelect Items="@AllSizes"
                  Label="Size"
                  @bind-Value="@Size" />

    <FluentSelect Items="@AllAlignments"
                  Label="Alignment"
                  @bind-Value="@Alignment" />
</FluentStack>

<FluentButton OnClick="@OpenDialogAsync"
              Appearance="ButtonAppearance.Primary">Open Dialog</FluentButton>

<hr />
<div>
    John: @John
</div>

@code
{
    private bool IsModal = true;
    private DialogSize? Size;
    private DialogAlignment? Alignment;
    private Dialog.PersonDetails John = new() { Age = "20" };

    private async Task OpenDialogAsync()
    {
        var result = await DialogService.ShowDialogAsync<Dialog.SimpleDialog>(options =>
        {
            options.Modal = IsModal;
            options.Size = Size;
            options.Alignment = Alignment;

            options.Parameters.Add(nameof(Dialog.SimpleDialog.Name), "John"); // Simple type
            options.Parameters.Add(nameof(Dialog.SimpleDialog.Person), John); // Updatable object

            options.OnStateChange = (e) =>
            {
                Console.WriteLine($"State changed: {e.State}");
            };
        });

        if (result.Cancelled)
        {
            Console.WriteLine($"Dialog Canceled: {result.Value}");
        }
        else
        {
            Console.WriteLine($"Dialog Saved: {result.Value}");
        }
    }

    private IEnumerable<DialogSize?> AllSizes
        => Enum.GetValues(typeof(DialogSize)).Cast<DialogSize?>().Prepend(null);

    private IEnumerable<DialogAlignment?> AllAlignments
        => Enum.GetValues(typeof(DialogAlignment)).Cast<DialogAlignment?>().Prepend(null);
}

    { "id": "e-s3-s4", "fromNode": "text-step3-1751300023", "toNode": "text-step4-1751300024", "fromSide": "bottom", "toSide": "top", "toEnd": "arrow", "color": "4" },
    { "id": "e-s4-s5", "fromNode": "text-step4-1751300024", "toNode": "text-step5-1751300025", "fromSide": "right", "toSide": "left", "toEnd": "arrow", "color": "4" },
    { "id": "e-s5-s6", "fromNode": "text-step5-1751300025", "toNode": "text-step6-1751300026", "fromSide": "right", "toSide": "left", "toEnd": "arrow", "color": "4" }
  ]
}
